{
  "name": "dsh-open-artifacts",
  "version": "0.4.0",
  "description": "在会话行的「⋯」菜单和会话标题栏加「打开产物文件夹」：从会话日志里算出这个对话真正产出过文件的目录，直接用资源管理器打开，不用自己翻。",
  "type": "module",
  "scripts": {
    "test": "node test/update.test.mjs && node test/client.test.mjs"
  },
  "license": "MIT",
  "author": "wuuuuu123-32",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuuuuu123-32/dsh-open-artifacts.git"
  },
  "homepage": "https://github.com/wuuuuu123-32/dsh-open-artifacts#readme",
  "bugs": {
    "url": "https://github.com/wuuuuu123-32/dsh-open-artifacts/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "session",
    "artifacts",
    "explorer"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
